# Copy to .env and fill in.  cp .env.example .env
# Only the LLM provider block is required to run; Langfuse is optional (tracing).

LLM_PROVIDER=deepinfra                 # "deepinfra" (hosted) or "ollama" (local)

# --- DeepInfra (hosted, per-token) - needed when LLM_PROVIDER=deepinfra ---
DEEPINFRA_API_KEY=                      # from https://deepinfra.com  (keep secret; never commit)
DEEPINFRA_MODEL=Qwen/Qwen3-32B

# --- local Ollama - needed when LLM_PROVIDER=ollama ---
OLLAMA_MODEL=qwen2.5-coder:latest
OLLAMA_BASE_URL=http://localhost:11434

# --- Langfuse tracing (optional; leave blank to disable) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
